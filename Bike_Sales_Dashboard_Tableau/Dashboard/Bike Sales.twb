    <worksheet name='YoY % Change'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales (Sales)' name='federated.1pdz1h21chf8w51168lxm1re3aqy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='2016' caption='Year Parameter' datatype='date' name='[Parameter 1136135679987716]' param-domain-type='list' role='measure' type='quantitative' value='#2016-01-01#'>
              <calculation class='tableau' formula='#2016-01-01#' />
              <aliases>
                <alias key='#2011-01-01#' value='2011' />
                <alias key='#2012-01-01#' value='2012' />
                <alias key='#2013-01-01#' value='2013' />
                <alias key='#2014-01-01#' value='2014' />
                <alias key='#2015-01-01#' value='2015' />
                <alias key='#2016-01-01#' value='2016' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pdz1h21chf8w51168lxm1re3aqy'>
            <column caption='Chosen Your Profit' datatype='integer' name='[Calculation_1136135681753094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Date - Year]=[Parameters].[Parameter 1136135679987716]THEN [Profit] END' />
            </column>
            <column caption='Last Year Profit' datatype='integer' name='[Calculation_1136135682633735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Date - Year]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1136135679987716])THEN [Profit]END' />
            </column>
            <column caption='YOY % Change' datatype='real' name='[Calculation_1136135683858440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1136135681753094])-SUM([Calculation_1136135682633735])/SUM([Calculation_1136135682633735])' />
            </column>
            <column caption='&quot;YOY % Change&quot;' datatype='string' name='[Calculation_1136135685300234]' role='dimension' type='nominal' user:unnamed='YoY % Change'>
              <calculation class='tableau' formula='&quot;YOY % Change&quot;' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[Date - Year]' role='dimension' type='quantitative' user:agg-type='Year-Trunc' user:base-field='Date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;year&apos;, [Date]))' />
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='integer' default-format='n#,##0;-#,##0' name='[Profit]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1136135685300234]' derivation='None' name='[none:Calculation_1136135685300234:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1136135683858440]' derivation='User' name='[usr:Calculation_1136135683858440:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.1pdz1h21chf8w51168lxm1re3aqy].[none:Country:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
